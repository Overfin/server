  "helloVersions": [
    {
      "name": "a number that isn't an integer is ignored",
      "text": "{\"state\":\"paired\",\"core\":[1,2.5]}",
      "valid": true,
      "output": "{\"core\":[1],\"parts\":{}}"
    },
    {
      "name": "in a part's list too",
      "text": "{\"state\":\"paired\",\"core\":[1],\"parts\":{\"catalog\":[1],\"video\":[1,2.5]}}",
      "valid": true,
      "output": "{\"core\":[1],\"parts\":{\"catalog\":[1],\"video\":[1]}}"
    },
    {
      "name": "entries that aren't non-negative integers are ignored",
      "text": "{\"state\":\"paired\",\"core\":[1,1.0,1e0,-1,-0,\"2\",null,true,[3]]}",
      "valid": true,
      "output": "{\"core\":[1],\"parts\":{}}"
    },
    {
      "name": "only the first 8 entries count",
      "text": "{\"state\":\"paired\",\"core\":[0,1,2,3,4,5,6,7,8]}",
      "valid": true,
      "output": "{\"core\":[0,1,2,3,4,5,6,7],\"parts\":{}}"
    },
    {
      "name": "duplicates count once",
      "text": "{\"state\":\"paired\",\"core\":[1,1],\"parts\":{\"media\":[2,1,2]}}",
      "valid": true,
      "output": "{\"core\":[1],\"parts\":{\"media\":[1,2]}}"
    },
    {
      "name": "no core: none",
      "text": "{\"state\":\"paired\"}",
      "valid": true,
      "output": "{\"core\":[],\"parts\":{}}"
    },
    {
      "name": "an empty core: none",
