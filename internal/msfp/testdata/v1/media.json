{
  "about": [
    "What a server does with media it serves or relays (spec/v1/media.md section 3). Generated by tools/vectors from the specification's rules; Overfin's own checks give the same verdicts.",
    "webvtt: a part (text, or hex when it isn't UTF-8), whether it is refused, and the rebuilt part (output) when it isn't (section 3.2). The size and cue-count limits are not exercised here.",
    "hls: playlists as the viewer's server checks them (section 3.1). valid means the checks pass; tags outside the subset may still be dropped before serving.",
    "pgs: PGS parts, in hex, as video.md section 6.4 checks them; times are zero. An empty part (no hex) is valid."
  ],
  "webvtt": [
    {
      "name": "a plain cue",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nHello\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nHello\n"
    },
    {
      "name": "byte order mark, CRLF, a cue identifier and cue settings",
      "text": "﻿WEBVTT\r\n\r\n1\r\n00:01.000 --> 00:02.500 align:start line:0\r\nHi\r\n",
      "valid": true,
      "output": "WEBVTT\n\n00:01.000 --> 00:02.500\nHi\n"
    },
    {
      "name": "hours of 1 to 3 digits",
      "text": "WEBVTT\n\n1:00:00.000 --> 123:00:00.000\nlong\n",
      "valid": true,
      "output": "WEBVTT\n\n1:00:00.000 --> 123:00:00.000\nlong\n"
    },
    {
      "name": "every cue tag removed, its text kept",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\n<b>Bold</b> <i>it</i> <u>u</u> <c.yellow.bg>c</c> <v Roger>voice</v> <lang en>x</lang> <ruby>kan<rt>ji</rt></ruby>\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nBold it u c voice x kan ji\n"
    },
    {
      "name": "an unknown tag",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\n<script>alert(1)</script>Text\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nalert(1) Text\n"
    },
    {
      "name": "a tag without its >",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nbefore <b class=x and the rest\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nbefore\n"
    },
    {
      "name": "character references decoded, then tags removed again",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nTom &amp; Jerry &lt;b&gt;x&lt;/b&gt; &#x3c;i&#62; &eacute;\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nTom &amp; Jerry x é\n"
    },
    {
      "name": "a lone < stays, escaped",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\na < b, <3 and a > c\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\na &lt; b, &lt;3 and a &gt; c\n"
    },
    {
      "name": "STYLE, NOTE and REGION blocks dropped",
      "text": "WEBVTT\n\nSTYLE\n::cue { color: red; background: url(https://example.org/x.png) }\n\nNOTE a note\n\nREGION\nid:r1\n\n00:00:01.000 --> 00:00:02.000\nx\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nx\n"
    },
    {
      "name": "a timestamp tag stays as text",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\n<00:00:01.500>karaoke\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\n&lt;00:00:01.500&gt;karaoke\n"
    },
    {
      "name": "a URL stays as text",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nsee https://example.org/x\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nsee https://example.org/x\n"
    },
    {
      "name": "direction controls removed",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\n‮abc⁦d‏\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nabcd\n"
    },
    {
      "name": "white space and controls collapsed",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\n  a\tb c\u0007d  \n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\na b c d\n"
    },
    {
      "name": "a malformed timing: the block dropped",
      "text": "WEBVTT\n\n00:00:01 --> 00:00:02\nno milliseconds\n\n00:00:01.000 --> 00:00:02.000\nkept\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nkept\n"
    },
    {
      "name": "a timing without spaces around -->: the block dropped",
      "text": "WEBVTT\n\n00:00:01.000-->00:00:02.000\nx\n",
      "valid": true,
      "output": "WEBVTT\n"
    },
    {
      "name": "a cue left empty: dropped",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\n<b></b>\n\n00:00:01.000 --> 00:00:02.000\nkept\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nkept\n"
    },
    {
      "name": "a line shaped like a timing, inside a cue, is text",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\none\n00:00:03.000 --> 00:00:04.000\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\none\n00:00:03.000 --&gt; 00:00:04.000\n"
    },
    {
      "name": "a cue right after the header, without an empty line",
      "text": "WEBVTT\n00:00:01.000 --> 00:00:02.000\nx\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nx\n"
    },
    {
      "name": "a line of spaces doesn't end a block",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\na\n   \nb\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\na\nb\n"
    },
    {
      "name": "out-of-range timings are not checked",
      "text": "WEBVTT\n\n00:99.999 --> 00:01.000\nx\n",
      "valid": true,
      "output": "WEBVTT\n\n00:99.999 --> 00:01.000\nx\n"
    },
    {
      "name": "a line cut to 500 bytes",
      "text": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\éb\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\\n"
    },
    {
      "name": "no cue left: valid",
      "text": "WEBVTT\n\nNOTE only a note\n",
      "valid": true,
      "output": "WEBVTT\n"
    },
    {
      "name": "the header is a prefix",
      "text": "WEBVTT - a title\n\n00:00:01.000 --> 00:00:02.000\nx\n",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nx\n"
    },
    {
      "name": "no WEBVTT header",
      "text": "00:00:01.000 --> 00:00:02.000\nx\n",
      "valid": false,
      "reason": "doesn't start with WEBVTT"
    },
    {
      "name": "empty",
      "valid": false,
      "reason": "doesn't start with WEBVTT"
    },
    {
      "name": "invalid UTF-8 removed",
      "hex": "5745425654540a0a30303a30303a30312e303030202d2d3e2030303a30303a30322e3030300a6162ff6364c30a",
      "valid": true,
      "output": "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nabcd\n"
    }
