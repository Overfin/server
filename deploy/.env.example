# Copy to .env, next to compose.yaml.

# Where your films and series are, on this machine. Jellyfin reads them,
# never writes. In the control panel, MEDIA_DIR_1 is /media.
MEDIA_DIR_1=/srv/media
# Optional: more folders, on other disks or network shares mounted on this
# machine; in the control panel, /media2, /media3 and /media4.
MEDIA_DIR_2=
MEDIA_DIR_3=
MEDIA_DIR_4=

# Optional: your domain (e.g. media.example.org), pointed at this machine,
# with ports 80 and 443 open to it. Overfin then gets its own HTTPS
# certificate. Empty: plain http, for your LAN.
OVERFIN_DOMAIN=

# Optional: your TMDB read access token (TMDB's "API Read Access Token"),
# or give it in the setup wizard or the control panel instead.
OVERFIN_TMDB_TOKEN=
