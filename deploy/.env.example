# Copy to .env, next to compose.yaml: every setting here is optional.
# Your films and series are on the media line of compose.yaml.

# Optional: your domain (e.g. media.example.org), pointed at this machine,
# with ports 80 and 443 open to it. Overfin then gets its own HTTPS
# certificate. Empty: plain http, for your LAN.
OVERFIN_DOMAIN=

# Optional: your TMDB read access token (TMDB's "API Read Access Token"),
# or give it in the setup wizard or the control panel instead.
OVERFIN_TMDB_TOKEN=

# Optional: the image, by default the version this bundle was made for
# (it carries its Jellyfin and Overfin's plugin).
# OVERFIN_IMAGE=ghcr.io/overfin/overfin:0.9.0

# Optional: the time zone (logs, Jellyfin's scheduled tasks); UTC by default.
# TZ=Europe/Paris
